# ms-books (:5002) - connects ONLY to the books schema with ms_books_role.

# --- Required ---
DB_HOST=localhost
DB_NAME=bookstore
DB_USER=ms_books_role
DB_PASSWORD=change_me_for_local_development

# --- Optional (defaults shown) ---
PORT=5002
NODE_ENV=development
SERVICE_NAME=ms-books
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
HTTP_TRUST_PROXY_HOPS=1
HTTP_JSON_BODY_LIMIT=32kb
ACCESS_LOG_ENABLED=true

# Catalog pagination
BOOKS_DEFAULT_LIMIT=24
BOOKS_MAX_LIMIT=100

# Internal stock API limits (per request)
STOCK_MAX_ITEMS_PER_REQUEST=100
STOCK_MAX_QUANTITY_PER_ITEM=1000

# Clickstream events (catalog_view / book_view) read by the pod sidecar
CLICKSTREAM_FILE_ENABLED=true
CLICKSTREAM_FILE_PATH=/var/log/clickstream/events.log

# Database client
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
