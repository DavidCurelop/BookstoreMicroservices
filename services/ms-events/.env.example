# ms-events (:5004) - clickstream aggregator. No database: it appends accepted
# events to EFS and buffers its own public behavior events for the sidecar.

# --- Optional (defaults shown) ---
PORT=5004
NODE_ENV=development
SERVICE_NAME=ms-events
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
HTTP_TRUST_PROXY_HOPS=1
HTTP_JSON_BODY_LIMIT=32kb
ACCESS_LOG_ENABLED=true

# Shared clickstream file (EFS mount in Kubernetes; use a local path outside Docker)
CLICKSTREAM_FILE_PATH=/usr/src/app/logs/clickstream.log
CLICKSTREAM_BUFFER_PATH=/var/log/clickstream/events.log

# POST /internal/events/ingest (sidecar batches)
INGEST_JSON_BODY_LIMIT=1mb
INGEST_MAX_BATCH_SIZE=1000
INGEST_MAX_LINE_LENGTH=8192
