# ms-auth (:5001) - connects ONLY to the auth schema with ms_auth_role.

# --- Required ---
DB_HOST=localhost
DB_NAME=bookstore
DB_USER=ms_auth_role
DB_PASSWORD=change_me_for_local_development

# Must be the same value the monolith uses so existing SPA cookies stay valid.
AUTH_JWT_SECRET=replace_this_local_secret_with_at_least_32_random_characters

# --- Optional (defaults shown) ---
PORT=5001
NODE_ENV=development
SERVICE_NAME=ms-auth
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
HTTP_TRUST_PROXY_HOPS=1
HTTP_JSON_BODY_LIMIT=32kb
ACCESS_LOG_ENABLED=true

# Clickstream events (login/logout) read by the pod sidecar
CLICKSTREAM_FILE_ENABLED=true
CLICKSTREAM_FILE_PATH=/var/log/clickstream/events.log

# JWT / cookie (HS256, compatible with the React SPA)
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=bookstore-api
AUTH_JWT_AUDIENCE=bookstore-web
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_NAME=bookstore_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api

# Database client
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
