# ms-orders (:5003) - connects ONLY to the orders schema with ms_orders_role,
# through the PgBouncer Ambassador sidecar (127.0.0.1:5432) in Kubernetes.

# --- Required ---
DB_NAME=bookstore
DB_USER=ms_orders_role
DB_PASSWORD=change_me_for_local_development

# Same secret ms-auth signs with (JWT is validated locally).
AUTH_JWT_SECRET=replace_this_local_secret_with_at_least_32_random_characters

# --- Optional (defaults shown) ---
PORT=5003
NODE_ENV=development
SERVICE_NAME=ms-orders
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
HTTP_TRUST_PROXY_HOPS=1
HTTP_JSON_BODY_LIMIT=32kb
ACCESS_LOG_ENABLED=true

# Order limits
ORDERS_MAX_DISTINCT_ITEMS=100
ORDERS_MAX_QUANTITY_PER_ITEM=1000

# Internal HTTP calls (customer check, reserve/release stock)
MS_AUTH_URL=http://ms-auth:5001
MS_BOOKS_URL=http://ms-books:5002
INTERNAL_HTTP_TIMEOUT_MS=5000

# Clickstream purchase events read by the pod sidecar
CLICKSTREAM_FILE_ENABLED=true
CLICKSTREAM_FILE_PATH=/var/log/clickstream/events.log

# JWT validation (HS256, compatible with ms-auth and the React SPA)
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=bookstore-api
AUTH_JWT_AUDIENCE=bookstore-web
AUTH_COOKIE_NAME=bookstore_session

# Database client (PgBouncer sidecar: plain TCP on localhost)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
